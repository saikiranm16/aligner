APP_NAME=AlignPDF
APP_ENV=development
API_PREFIX=/api/v1
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE=5
JOB_RETENTION_HOURS=24
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
STORAGE_ROOT=./data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
OCR_LANGUAGES=eng
OCR_DPI=300
ENABLE_LAYOUT_REFINER=true
PREVIEW_RENDER_ZOOM=1.5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TESSERACT_CMD=
AUTH_SECRET_KEY=change-me-alignpdf-secret
AUTH_TOKEN_EXPIRY_MINUTES=720
ENABLE_MALWARE_SCAN=false
CLAMAV_HOST=
CLAMAV_PORT=3310
SUMMARY_DEFAULT_MODEL=facebook/bart-large-cnn
CLASSIFICATION_DEFAULT_MODEL=facebook/bart-large-mnli
SENTIMENT_DEFAULT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
AI_CACHE_TTL_MINUTES=120
ENABLE_TRANSFORMERS=true
